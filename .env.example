# Dat Commerce Environment Variables (Copy to .env and fill secrets)

APP_PORT=8088

# PostgreSQL
POSTGRES_DB=dat_commerce
POSTGRES_USER=dat_commerce
POSTGRES_PASSWORD=change_me_postgres_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Object Storage (S3 / Silo / MinIO)
MINIO_ROOT_USER=datcommerce
MINIO_ROOT_PASSWORD=change_me_silo_password
MINIO_BUCKET=dat-commerce-media

# Security & Sessions
JWT_SECRET=replace_with_a_64_char_random_hex_secret_for_hs256_jwt_signing_key
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
APP_COOKIE_SECURE=false
APP_SEED_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8088,http://100.98.214.94:8088

# AI Gateway (9Router - Server-side only; never expose to browser)
AI_GATEWAY_MODE=mock
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AI_DEFAULT_MODEL=claude-sonnet-4
AI_COMPLEX_TASK_MODEL=claude-sonnet-4
AI_FAST_TASK_MODEL=forma-fast
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOOL_ROUNDS=6
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=4096
