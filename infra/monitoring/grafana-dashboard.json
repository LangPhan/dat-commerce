{
  "title": "Dat Commerce — Runtime, AI Gateway & Commerce Overview",
  "uid": "dat-commerce-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API Availability",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "up{job=\"dat-commerce-api\"}" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Rate & 5xx",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (status)", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AI Turns & Token Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(increase(datcommerce_ai_turns_total[15m])) by (model, status)", "legendFormat": "turns {{model}} ({{status}})" },
        { "expr": "sum(increase(datcommerce_ai_tokens_prompt_total[15m]))", "legendFormat": "prompt tokens" },
        { "expr": "sum(increase(datcommerce_ai_tokens_completion_total[15m]))", "legendFormat": "completion tokens" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "AI Change Plans & Order Checkouts",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "sum(increase(datcommerce_ai_plans_total[15m])) by (plan_type, status)", "legendFormat": "plan {{plan_type}} ({{status}})" },
        { "expr": "sum(increase(datcommerce_orders_checkout_total[15m])) by (status)", "legendFormat": "checkout ({{status}})" },
        { "expr": "sum(increase(datcommerce_orders_canceled_total[15m]))", "legendFormat": "canceled orders" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM Heap Memory Used vs Max",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
      ]
    }
  ]
}
